{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mono",
  "version": "0.1.0",
  "identifier": "app.mono.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mono",
        "width": 1120,
        "height": 740,
        "minWidth": 760,
        "minHeight": 500,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwMjUzQThGQzc4NzIwQjYKUldTMklJZkhqem9sb0YrNjQ0SWc0cXZkejIxcVk0QXZPOUhMdDE0bVU2c25HU2dyQkVIWVl5eDUK",
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
