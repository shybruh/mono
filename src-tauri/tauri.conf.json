{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mono",
  "version": "0.1.0",
  "identifier": "app.mono.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mono",
        "width": 1120,
        "height": 740,
        "minWidth": 760,
        "minHeight": 500,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3"
        ],
        "name": "MP3 audio",
        "description": "MP3 audio",
        "role": "Viewer",
        "mimeType": "audio/mpeg"
      },
      {
        "ext": [
          "flac"
        ],
        "name": "FLAC audio",
        "description": "FLAC audio",
        "role": "Viewer",
        "mimeType": "audio/flac"
      },
      {
        "ext": [
          "wav"
        ],
        "name": "WAV audio",
        "description": "WAV audio",
        "role": "Viewer",
        "mimeType": "audio/wav"
      },
      {
        "ext": [
          "ogg",
          "oga"
        ],
        "name": "Ogg audio",
        "description": "Ogg Vorbis audio",
        "role": "Viewer",
        "mimeType": "audio/ogg"
      },
      {
        "ext": [
          "m4a",
          "aac"
        ],
        "name": "AAC audio",
        "description": "AAC / M4A audio",
        "role": "Viewer",
        "mimeType": "audio/mp4"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwMjUzQThGQzc4NzIwQjYKUldTMklJZkhqem9sb0YrNjQ0SWc0cXZkejIxcVk0QXZPOUhMdDE0bVU2c25HU2dyQkVIWVl5eDUK",
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
